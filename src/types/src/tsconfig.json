{
  "compilerOptions": {
    "strictNullChecks": true,
    "module": "Node16",
    "target": "esnext",
    "jsx": "react",
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "lib": ["esnext", "es2019"],
    "paths": {
      "*": ["./*"]
    }
  },
  "exclude": []
}
